# ==============================================================
# Environment Configuration Template (DO NOT COMMIT REAL KEYS)
# Copy this file to .env and insert your real API keys
# ==============================================================

# Groq API Key (Get from https://console.groq.com/keys)
GROQ_API_KEY="your_groq_api_key_here"

# Tavily Search API Key (Get from https://app.tavily.com)
TAVILY_API_KEY="your_tavily_api_key_here"

# Optional: OpenAI API Key (if switching to OpenAI models)
OPENAI_API_KEY="your_openai_api_key_here"

# Model Configuration
GROQ_MODEL_NAME="openai/gpt-oss-120b"
MAX_SEARCH_RESULTS=5
SEARCH_DEPTH="advanced"
